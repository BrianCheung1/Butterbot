DISCORD_TOKEN=your-discord-bot-token
# Required immutable deployment/build identifier (for example a git SHA or image digest tag).
BUTTERBOT_RELEASE_ID=development
BUTTERBOT_DATABASE_PATH=C:\absolute\path\to\butterbot.sqlite3
BUTTERBOT_DATABASE_ROOT=C:\absolute\path\to
# Required for production mutation enablement: Linux mount major:minor from /proc/self/mountinfo.
BUTTERBOT_DATABASE_VOLUME_ID=
# Required with a production volume: reviewed administrator owner UID and Butterbot service-group GID.
BUTTERBOT_DATABASE_ADMINISTRATOR_UID=
BUTTERBOT_DATABASE_SERVICE_GROUP_GID=
BUTTERBOT_ECONOMY_MUTATIONS_ENABLED=false

# Optional isolated interactive /join launcher; uses a separate development bot.
# These are ignored by normal startup. Never put a real token in this example file.
BUTTERBOT_DEV_DISCORD_TOKEN=
BUTTERBOT_DEV_GUILD_ID=
BUTTERBOT_DEV_USER_ID=
BUTTERBOT_DEV_CHANNEL_ID=

# Slice 1.3: all values require an explicit reviewed policy; empty keeps proposals unavailable.
BUTTERBOT_SAFETY_APPROVAL_THRESHOLD=
BUTTERBOT_SAFETY_OPERATION_CEILING=
BUTTERBOT_SAFETY_24H_CEILING=
BUTTERBOT_SAFETY_ALERT_DESTINATION=
# Only the disposable development launcher consumes this one-time-per-database bootstrap list.
BUTTERBOT_DEV_SAFETY_BOOTSTRAP_IDS=
